defmodule <%= @module %> do
  @moduledoc """
  Stack-installable Spectre package generated by `mix spectre.gen.installable`.

  Install this package in an application's Stack. Set `as:` on the installation
  to use a shorter local identifier in scoped calls. Define `integration/1`
  with `Spectre.Integration` as you add tools, flows, services, or Activity
  types. A declared Activity starts when a Server calls `start_activity`.
  """

  use Spectre.Stack.Installable,
    id: "<%= @package_id %>",
    version: "0.1.0",
    contract: 1,
    spectre: "<%= @spectre_requirement %>"
end
