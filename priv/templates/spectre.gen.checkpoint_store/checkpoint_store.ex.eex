defmodule <%= @module %> do
  @moduledoc """
  Process-local Instance checkpoint adapter generated by
  `mix spectre.gen.checkpoint_store`.

  Pass an `Agent` pid as `:server`. This implementation is useful for tests
  and development; use durable compare-and-swap storage in production.
  """

  @behaviour Spectre.Instance.CheckpointStore

  alias Spectre.Foundation.Conformance, as: Foundation
  alias Spectre.Instance.Erasure.Status

  @impl true
  def load(ref, opts) do
    server = Keyword.fetch!(opts, :server)

    case Agent.get(server, &Map.get(&1, ref.key)) do
      nil -> :not_found
      {:checkpoint, _revision, checkpoint} -> {:ok, checkpoint}
      {:erased, %Status{}} -> :not_found
    end
  end

  @impl true
  def compare_and_swap(ref, checkpoint, expected, revision, opts) do
    Agent.get_and_update(Keyword.fetch!(opts, :server), fn checkpoints ->
      current = Map.get(checkpoints, ref.key)

      case current do
        {:erased, %Status{}} ->
          {{:error, :instance_erased}, checkpoints}

        {:checkpoint, ^revision, ^checkpoint} ->
          {:ok, checkpoints}

        nil when expected == 0 ->
          {:ok, Map.put(checkpoints, ref.key, {:checkpoint, revision, checkpoint})}

        {:checkpoint, ^expected, _current} ->
          {:ok, Map.put(checkpoints, ref.key, {:checkpoint, revision, checkpoint})}

        {:checkpoint, actual, _current} ->
          {{:error, {:stale_checkpoint, actual}}, checkpoints}

        nil ->
          {{:error, {:stale_checkpoint, :not_found}}, checkpoints}
      end
    end)
  end

  @impl true
  def erase(ref, request, opts) do
    Agent.get_and_update(Keyword.fetch!(opts, :server), fn checkpoints ->
      case Map.get(checkpoints, ref.key) do
        {:erased, %Status{}} ->
          {{:ok, :already_erased}, checkpoints}

        current ->
          erase_current(ref, request, current, checkpoints)
      end
    end)
  end

  @impl true
  def erasure_status(ref, opts) do
    case Agent.get(Keyword.fetch!(opts, :server), &Map.get(&1, ref.key)) do
      {:erased, %Status{} = status} -> {:ok, status}
      _other -> :not_erased
    end
  end

  defp erase_current(ref, request, nil, checkpoints) do
    if is_nil(request.expected_revision) and is_nil(request.checkpoint_digest),
      do: install_marker(request, checkpoints, ref.key),
      else: {{:error, :checkpoint_changed}, checkpoints}
  end

  defp erase_current(ref, request, {:checkpoint, revision, checkpoint}, checkpoints) do
    with true <- revision == request.expected_revision,
         {:ok, %{digest: digest}} <- Foundation.verify_instance_checkpoint(checkpoint, ref),
         true <- digest == request.checkpoint_digest do
      install_marker(request, checkpoints, ref.key)
    else
      _mismatch -> {{:error, :checkpoint_changed}, checkpoints}
    end
  end

  defp install_marker(request, checkpoints, key) do
    {:ok, status} = Status.from_request(request, System.system_time(:millisecond))
    {{:ok, :erased}, Map.put(checkpoints, key, {:erased, status})}
  end
end
